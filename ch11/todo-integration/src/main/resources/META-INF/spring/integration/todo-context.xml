<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:int="http://www.springframework.org/schema/integration"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd http://www.springframework.org/schema/integration http://www.springframework.org/schema/integration/spring-integration.xsd">

    <int:channel id="input"/>

    <!-- Use property access, not method calls -->
    <int:filter input-channel="input"
                expression="payload.completed"
                output-channel="filter"/>

    <int:channel id="filter"/>

    <!-- Use property access, not method calls -->
    <int:transformer input-channel="filter"
                     expression="payload.description.toUpperCase()"
                     output-channel="log"/>

    <int:channel id="log"/>
    <int:logging-channel-adapter channel="log"/>

</beans>